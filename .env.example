# backstep-cloud configuration
# Copy to .env and fill in real values. .env is gitignored.

LISTEN_ADDR=0.0.0.0:50051
DATABASE_URL=postgres://user:password@localhost:5432/backstep_cloud
DB_MAX_CONNECTIONS=10

R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=backstep-packs
R2_ACCESS_KEY_ID=<r2_access_key_id>
R2_SECRET_ACCESS_KEY=<r2_secret_access_key>
R2_REGION=auto

MAX_PACK_BYTES=8388608
MAX_PULL_OPERATIONS=100

# TLS (optional for local dev, mandatory for production)
# TLS_CERT_PATH=/etc/backstep-cloud/cert.pem
# TLS_KEY_PATH=/etc/backstep-cloud/key.pem

LOG_LEVEL=info
